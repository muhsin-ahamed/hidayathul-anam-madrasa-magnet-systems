generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum app_role {
  student
  class_teacher
  super_admin
}

model profiles {
  id            String          @id @default(uuid()) @db.Uuid
  username      String?         @unique
  full_name     String
  email         String?
  phone         String?
  role          app_role
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  
  classes       classes[]       @relation("class_teacher")
  students      students?
  teachers      teachers?
  exams         exams[]
  results       results[]
  notes         notes[]
  announcements announcements[]
  activity_logs activity_logs[]
  app_settings  app_settings[]
  users         users?
}

// Added for authentication, since we don't modify existing tables (except foreign keys).
model users {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username      String   @unique
  password_hash String
  role          app_role
  profile_id    String   @unique @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  profile       profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([username])
  @@index([profile_id])
  @@index([role])
}

model classes {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  class_name       String
  section          String?
  academic_year    String
  class_teacher_id String?         @unique @db.Uuid
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  
  profile          profiles?       @relation("class_teacher", fields: [class_teacher_id], references: [id], onDelete: SetNull)
  students         students[]
  subjects         subjects[]
  exams            exams[]
  notes            notes[]
  announcements    announcements[]
  activity_logs    activity_logs[]
}

model students {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id       String?        @unique @db.Uuid
  admission_number String         @unique
  roll_number      String
  full_name        String
  class_id         String         @db.Uuid
  date_of_birth    DateTime?      @db.Date
  gender           String?
  guardian_name    String?
  guardian_phone   String?
  address          String?
  photo_path       String?
  is_active        Boolean        @default(true)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  
  profile          profiles?      @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  class            classes        @relation(fields: [class_id], references: [id])
  results          results[]
  hall_tickets     hall_tickets[]

  @@unique([class_id, roll_number])
}

model teachers {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profile_id       String    @unique @db.Uuid
  employee_number  String?   @unique
  qualification    String?
  joined_date      DateTime? @db.Date
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)
  
  profile          profiles  @relation(fields: [profile_id], references: [id], onDelete: Cascade)
}

model subjects {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subject_name  String
  subject_code  String?
  class_id      String          @db.Uuid
  maximum_marks Decimal         @default(100) @db.Decimal
  pass_marks    Decimal         @default(35) @db.Decimal
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  
  class         classes         @relation(fields: [class_id], references: [id])
  exam_subjects exam_subjects[]
  results       results[]
  notes         notes[]
}

model exams {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_name          String
  term               String?
  class_id           String          @db.Uuid
  exam_center        String?
  reporting_time     DateTime?       @db.Time(6)
  start_date         DateTime?       @db.Date
  end_date           DateTime?       @db.Date
  results_published  Boolean         @default(false)
  hall_ticket_locked Boolean         @default(false)
  created_by         String?         @db.Uuid
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  
  class              classes         @relation(fields: [class_id], references: [id])
  profile            profiles?       @relation(fields: [created_by], references: [id])
  exam_subjects      exam_subjects[]
  results            results[]
  hall_tickets       hall_tickets[]
}

model exam_subjects {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id       String    @db.Uuid
  subject_id    String    @db.Uuid
  exam_date     DateTime? @db.Date
  start_time    DateTime? @db.Time(6)
  end_time      DateTime? @db.Time(6)
  maximum_marks Decimal   @default(100) @db.Decimal
  pass_marks    Decimal   @default(35) @db.Decimal
  
  exam          exams     @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  subject       subjects  @relation(fields: [subject_id], references: [id])

  @@unique([exam_id, subject_id])
}

model results {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id        String    @db.Uuid
  student_id     String    @db.Uuid
  subject_id     String    @db.Uuid
  marks_obtained Decimal?  @db.Decimal
  maximum_marks  Decimal   @default(100) @db.Decimal
  grade          String?
  result_status  String?
  remarks        String?
  is_published   Boolean   @default(false)
  published_at   DateTime? @db.Timestamptz(6)
  created_by     String?   @db.Uuid
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  
  exam           exams     @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student        students  @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subject        subjects  @relation(fields: [subject_id], references: [id])
  profile        profiles? @relation(fields: [created_by], references: [id])

  @@unique([exam_id, student_id, subject_id])
}

model notes {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String
  description  String?
  class_id     String    @db.Uuid
  subject_id   String?   @db.Uuid
  teacher_id   String?   @db.Uuid
  file_path    String
  file_name    String?
  file_size    BigInt?
  is_published Boolean   @default(true)
  uploaded_at  DateTime  @default(now()) @db.Timestamptz(6)
  
  class        classes   @relation(fields: [class_id], references: [id])
  subject      subjects? @relation(fields: [subject_id], references: [id])
  teacher      profiles? @relation(fields: [teacher_id], references: [id])
}

model hall_tickets {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exam_id            String    @db.Uuid
  student_id         String    @db.Uuid
  hall_ticket_number String    @unique
  status             String    @default("generated")
  generated_at       DateTime  @default(now()) @db.Timestamptz(6)
  locked_at          DateTime? @db.Timestamptz(6)
  file_path          String?
  
  exam               exams     @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student            students  @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([exam_id, student_id])
}

model announcements {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  message          String
  target_type      String    @default("all")
  target_class_id  String?   @db.Uuid
  published_by     String?   @db.Uuid
  published_at     DateTime  @default(now()) @db.Timestamptz(6)
  expires_at       DateTime? @db.Timestamptz(6)
  is_active        Boolean   @default(true)
  
  class            classes?  @relation(fields: [target_class_id], references: [id])
  profile          profiles? @relation(fields: [published_by], references: [id])
}

model activity_logs {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  action      String
  entity_type String?
  entity_id   String?   @db.Uuid
  description String?
  class_id    String?   @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  
  profile     profiles? @relation(fields: [user_id], references: [id])
  class       classes?  @relation(fields: [class_id], references: [id])
}

model app_settings {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setting_key   String    @unique
  setting_value Json?
  updated_by    String?   @db.Uuid
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  
  profile       profiles? @relation(fields: [updated_by], references: [id])
}
